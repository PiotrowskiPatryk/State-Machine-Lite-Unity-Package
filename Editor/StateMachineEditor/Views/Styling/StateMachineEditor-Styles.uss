.button-no-border {
    background-color: rgba(0, 0, 0, 0);
    -unity-font: url('project://database/Packages/dev.cortez.state-machines/Runtime/StateMachineEditor/Inter-VariableFont_opsz,wght.ttf?fileID=12800000&guid=cd98b80116b484ae09e16718ab2aea43&type=3#Inter-VariableFont_opsz,wght');
    color: rgb(255, 255, 255);
    font-size: 18px;
    opacity: 1;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.selected {
    color: rgb(17, 115, 212);
    border-bottom-width: 1px;
    border-bottom-color: rgb(17, 115, 212);
}

.not-selected {
    color: rgb(163, 163, 163);
}

.button-no-border:hover {
    border-bottom-color: rgb(17, 115, 212);
}

.text-normal {
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Medium.ttf?fileID=12800000&guid=7c9798c1e9b61304baf3ecef769b48f9&type=3#Inter_18pt-Medium");
}

.text-bold {
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Bold.ttf?fileID=12800000&guid=2e1527e5f7d2b0546ba028b67a53d316&type=3#Inter_18pt-Bold");
}

.text-italic {
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Italic.ttf?fileID=12800000&guid=38bc0a2e2100c5949a43d37f55ef3d46&type=3#Inter_18pt-Italic");
}

.unity-button {
    background-color: rgb(17, 115, 212);
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Bold.ttf?fileID=12800000&guid=2e1527e5f7d2b0546ba028b67a53d316&type=3#Inter_18pt-Bold");
    color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-font-style: normal;
}

.unity-button:hover {
    background-color: rgb(2, 86, 168);
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Bold.ttf?fileID=12800000&guid=2e1527e5f7d2b0546ba028b67a53d316&type=3#Inter_18pt-Bold");
    color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-font-style: normal;
}

.unity-base-field {
    flex-direction: column;
    flex-shrink: 0;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-top: 5px;
    padding-left: 5px;
}

.background-main {
    background-color: rgb(16, 25, 34);
}

.unity-base-field__input {
    background-color: rgb(16, 25, 34);
    border-left-color: rgb(50, 77, 103);
    border-right-color: rgb(50, 77, 103);
    border-top-color: rgb(50, 77, 103);
    border-bottom-color: rgb(50, 77, 103);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    color: rgb(255, 255, 255);
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.unity-base-field__label {
    margin-bottom: 5px;
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Medium.ttf?fileID=12800000&guid=7c9798c1e9b61304baf3ecef769b48f9&type=3#Inter_18pt-Medium");
    color: rgb(146, 173, 201);
}

.unity-base-text-field__input--multiline {
    white-space: normal;
    text-overflow: clip;
    width: 100%;
}

.unity-multi-column-header__column {
    background-color: rgba(16, 34, 52, 0.52);
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Bold.ttf?fileID=12800000&guid=2e1527e5f7d2b0546ba028b67a53d316&type=3#Inter_18pt-Bold");
    min-height: 25px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(50, 77, 103);
    border-right-color: rgb(50, 77, 103);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 1px;
    border-left-width: 1px;
}

.unity-collection-view {
    border-left-color: rgb(16, 52, 87);
    border-right-color: rgb(16, 52, 87);
    border-top-color: rgb(16, 52, 87);
    border-bottom-color: rgb(16, 52, 87);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    background-color: rgba(16, 25, 34, 0);
}

.unity-vector2-int-field .unity-base-field {
    align-content: flex-start;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-grow: 1;
}

.unity-scroll-view__content-container {
    background-color: rgba(255, 255, 255, 0);
}

.text-white {
    color: rgb(255, 255, 255);
}

.unity-multi-column-view__cell > .unity-label {
    margin-top: 10px;
    margin-bottom: 10px;
}

.unity-tab {
    border-left-color: rgb(50, 77, 103);
    border-right-color: rgb(50, 77, 103);
    border-top-color: rgb(50, 77, 103);
    border-bottom-color: rgb(50, 77, 103);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.text-header {
    -unity-font-definition: url("project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Fonts/Inter_18pt-Bold.ttf?fileID=12800000&guid=2e1527e5f7d2b0546ba028b67a53d316&type=3#Inter_18pt-Bold");
    font-size: 20px;
}

.transition-foldout .unity-base-field__input {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

/* ---- Graph Node Styles ---- */

.state-graph-node:hover {
    border-left-color: rgb(80, 120, 160);
    border-right-color: rgb(80, 120, 160);
    border-top-color: rgb(80, 120, 160);
    border-bottom-color: rgb(80, 120, 160);
    transition-duration: 0.15s;
}

.initial-state .state-graph-node {
    border-left-color: rgb(76, 175, 80);
    border-right-color: rgb(76, 175, 80);
    border-top-color: rgb(76, 175, 80);
    border-bottom-color: rgb(76, 175, 80);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}
