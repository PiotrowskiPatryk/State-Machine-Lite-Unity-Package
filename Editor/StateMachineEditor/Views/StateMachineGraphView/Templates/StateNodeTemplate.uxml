<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineEditor/StateMachineEditor-Styles.uss?fileID=7433441132597879392&amp;guid=163ddde40eaf8431c92dc64dc65b31e9&amp;type=3#StateMachineEditor-Styles"/>
    <Dev.Cortez.StateMachines.Editor.StateMachineEditor.Views.StateMachineGraphView.StateGraphNode
            data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineContainerEditor.ViewModels.StateDefinitionViewModel, Dev.Cortez.StateMachines.Editor"
            snap="10">
        <ui:VisualElement name="NodeElement"
                          data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineContainerEditor.ViewModels.StateDefinitionViewModel, Dev.Cortez.StateMachines.Editor"
                          class="state-graph-node"
                          style="flex-grow: 1; position: relative; min-width: 200px; max-width: 400px; min-height: 100px; max-height: 100px; background-color: rgb(26, 36, 47); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; align-items: flex-start; justify-content: center; border-left-color: rgb(48, 73, 98); border-right-color: rgb(48, 73, 98); border-top-color: rgb(48, 73, 98); border-bottom-color: rgb(48, 73, 98); padding-right: 20px; padding-left: 20px;">
            <ui:Label text="StateName" name="StateNameLabel" class="text-bold"
                      style="color: white; font-size: 24px; text-overflow: ellipsis; white-space: nowrap;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Name" binding-mode="ToTarget"
                                    update-trigger="EveryUpdate"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="StateType" name="StateTypeLabel" class="text-normal"
                      style="color: rgba(255, 255, 255, 0.75); font-size: 12px; text-overflow: ellipsis; white-space: nowrap;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="TypeNameShort" binding-mode="ToTarget"
                                    update-trigger="EveryUpdate"/>
                </Bindings>
            </ui:Label>
            <ui:Button name="OutputNode"
                       icon-image="project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Sprites/Icon_Arrow.png?fileID=2800000&amp;guid=1e704a177b25a4c4dada0c330979d64a&amp;type=3#Icon_Arrow"
                       style="right: -22px; position: absolute; background-color: rgba(88, 88, 88, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; top: auto; width: 30px;"/>
            <ui:Button name="InputNode"
                       icon-image="project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Sprites/Icon_Arrow.png?fileID=2800000&amp;guid=1e704a177b25a4c4dada0c330979d64a&amp;type=3#Icon_Arrow"
                       style="right: auto; position: absolute; background-color: rgba(88, 88, 88, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; top: auto; width: 30px; left: -18px;"/>
        </ui:VisualElement>
        <Bindings>
            <ui:DataBinding property="value" data-source-path="NodePosition" binding-mode="TwoWay"/>
        </Bindings>
    </Dev.Cortez.StateMachines.Editor.StateMachineEditor.Views.StateMachineGraphView.StateGraphNode>
</ui:UXML>
