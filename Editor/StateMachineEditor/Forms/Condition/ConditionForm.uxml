<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineEditor/StateMachineEditor-Styles.uss?fileID=7433441132597879392&amp;guid=163ddde40eaf8431c92dc64dc65b31e9&amp;type=3#StateMachineEditor-Styles"/>
    <ui:VisualElement name="Root"
                      data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineContainerEditor.ViewModels.ConditionDefinitionViewModel, Dev.Cortez.StateMachines.Editor"
                      class="background-main" style="flex-grow: 1; justify-content: space-between; flex-shrink: 0;">
        <ui:VisualElement
                style="flex-grow: 1; flex-shrink: 0; margin-top: 10px; margin-bottom: 10px; margin-right: 10px; margin-left: 10px; justify-content: flex-start;">
            <ui:TextField label="Id" readonly="true" name="IdField">
                <Bindings>
                    <ui:DataBinding property="value" binding-mode="ToTarget" data-source-path="Id"/>
                </Bindings>
            </ui:TextField>
            <ui:TextField label="Name" name="NameField">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="Name" binding-mode="TwoWay"/>
                </Bindings>
            </ui:TextField>
            <ui:TextField label="Description" name="DescriptionField" multiline="true" style="min-height: 180px;">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="Description" binding-mode="TwoWay"/>
                </Bindings>
            </ui:TextField>
            <Dev.Cortez.StateMachines.Editor.StateMachineEditor.Views.VisualElements.TypePickerDropdownField
                    name="TypePicker"
                    label="Type"/>
            <uie:PropertyField name="PayloadPropertyField"/>
            <ui:VisualElement name="Spacer" style="flex-grow: 1;"/>
            <ui:VisualElement name="Buttons" style="flex-grow: 0; flex-direction: row; justify-content: center;">
                <ui:Button text="Submit" name="SubmitButton"
                           style="align-self: flex-end; min-height: 30px; min-width: 100px;"/>
                <ui:Button text="Cancel" name="CancelButton"
                           style="align-self: flex-end; min-width: 100px; min-height: 30px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
