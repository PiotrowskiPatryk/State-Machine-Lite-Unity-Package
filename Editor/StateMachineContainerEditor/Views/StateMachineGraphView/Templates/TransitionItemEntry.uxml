<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="TransitionEntry" data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineContainerEditor.ViewModels.TransitionRuleDefinitionViewModel, Dev.Cortez.StateMachines.Editor" style="flex-grow: 1; min-height: 48px; background-color: rgb(26, 36, 47); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 10px; padding-right: 10px;">
        <ui:Label text="→" name="Arrow" class="text-normal" style="font-size: 20px;" />
        <ui:VisualElement name="Spacer" style="width: 20px;" />
        <ui:Label text="{TargetState}" name="Text" class="text-normal">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="TargetState.Name" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
        <ui:VisualElement style="flex-grow: 1;" />
        <ui:Button icon-image="project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Sprites/Icon_Edit.png?fileID=2800000&amp;guid=219da9f16505346c19471dee70882a83&amp;type=3#Icon_Edit" name="EditButton" style="background-color: rgba(17, 115, 212, 0); width: 32px; height: 32px;" />
        <ui:Button icon-image="project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Sprites/Icon_Delete.png?fileID=2800000&amp;guid=e7f5810d8cf50469caf6bb946a7e6be9&amp;type=3#Icon_Delete" name="RemoveButton" style="background-color: rgba(17, 115, 212, 0); width: 32px; height: 32px;" />
    </ui:VisualElement>
</ui:UXML>
