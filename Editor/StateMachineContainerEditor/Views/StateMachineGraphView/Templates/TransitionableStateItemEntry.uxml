<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Foldout text="{StateName}" name="TransitionableStateItemEntry" data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineContainerEditor.ViewModels.StateDefinitionViewModel, Dev.Cortez.StateMachines.Editor" toggle-on-label-click="true" class="transition-foldout" style="border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; background-color: rgb(16, 25, 34); padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
        <ui:ListView item-template="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineContainerEditor/Views/StateMachineGraphView/Templates/TransitionItemEntry.uxml?fileID=9197481963319205126&amp;guid=8afd520781d4b164baf4c7c14b384d23&amp;type=3#TransitionItemEntry" binding-source-selection-mode="AutoAssign" virtualization-method="DynamicHeight">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Transitions" />
            </Bindings>
        </ui:ListView>
        <ui:Button text="Add Transition" style="min-height: 40px;" />
        <Bindings>
            <ui:DataBinding property="text" data-source-path="Name" binding-mode="ToTarget" />
        </Bindings>
    </ui:Foldout>
</ui:UXML>
