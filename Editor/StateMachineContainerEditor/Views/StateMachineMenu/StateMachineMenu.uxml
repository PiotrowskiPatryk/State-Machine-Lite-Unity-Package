<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineEditor/StateMachineEditor-Styles.uss?fileID=7433441132597879392&amp;guid=163ddde40eaf8431c92dc64dc65b31e9&amp;type=3#StateMachineEditor-Styles" />
    <ui:VisualElement name="Form" class="background-main" style="flex-grow: 1; min-height: 0; min-width: 0;">
        <ui:TabView style="flex-grow: 1; min-height: 0; min-width: 0;">
            <ui:Tab label="General" name="GeneralInformationTab">
                <ui:TextField label="Id" placeholder-text="Id" readonly="true" name="StateMachineId">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="Id" binding-mode="ToTarget" />
                    </Bindings>
                </ui:TextField>
                <ui:TextField label="Name" name="StateMachineName">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="Name" binding-mode="TwoWay" />
                    </Bindings>
                </ui:TextField>
                <ui:TextField label="Description" name="StateMachineDescription" multiline="true" style="min-height: 128px; max-height: 128px;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="Description" binding-mode="TwoWay" />
                    </Bindings>
                </ui:TextField>
                <Dev.Cortez.StateMachines.Editor.StateMachineEditor.Fields.TypePickerDropdownField name="TransitionSolverTypeDropdown" label="Transition solver type" />
                <Dev.Cortez.StateMachines.Editor.StateMachineEditor.Fields.TypePickerDropdownField name="StateMachineTypeDropdown" label="State machine type" />
                <UnityEditor.UIElements.PropertyField name="PayloadPropertyField" />
            </ui:Tab>
            <ui:Tab label="States" name="StatesTab">
                <ui:MultiColumnListView name="StatesListView" allow-remove="false" allow-add="false" virtualization-method="DynamicHeight">
                    <Bindings>
                        <ui:DataBinding property="itemsSource" data-source-path="States" />
                    </Bindings>
                    <ui:Columns primary-column-name="Id">
                        <ui:Column name="Id" title="Id" stretchable="true" />
                        <ui:Column name="Name" title="Name" stretchable="true" />
                        <ui:Column name="Description" title="Description" stretchable="true" />
                        <ui:Column name="Type" title="Type" stretchable="true" />
                        <ui:Column cell-template="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineContainerEditor/CustomElements/TableItemButtons.uxml?fileID=9197481963319205126&amp;guid=d7807b0c1a28a9645889e99e42ab2369&amp;type=3#TableItemButtons" min-width="100px" max-width="100px" resizable="false" />
                    </ui:Columns>
                    <ui:SortColumnDescriptions />
                </ui:MultiColumnListView>
                <ui:Button text="Add new state" name="AddStateButton" style="align-self: flex-end; min-height: 32px; max-height: 32px;" />
            </ui:Tab>
            <ui:Tab label="Node editor" name="GraphEditor" style="flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; position: relative; padding: 0;">
                <ui:VisualElement name="StateMachineGraphContainer" style="position: relative; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; flex-grow: 1; flex-shrink: 0; height: 600px;" />
            </ui:Tab>
        </ui:TabView>
    </ui:VisualElement>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; position: absolute; right: 0; top: 2px; flex-direction: row;">
        <ui:Button text="Add transition" name="AddTransitionButton" style="position: relative; right: 10px; padding: 4px; max-height: 32px; min-height: 32px;" />
        <ui:Button text="Save" icon-image="project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Sprites/Icon_Save.png?fileID=2800000&amp;guid=7532d6b95cc030e4c9081e3d9830ca63&amp;type=3#Icon_Save" name="SaveButton" style="position: relative; right: 10px; padding: 4px; max-height: 32px; min-height: 32px;" />
        <ui:Button text="Exit" icon-image="project://database/Packages/dev.cortez.state-machines/Runtime/Assets/Sprites/Icon_Exit.png?fileID=2800000&amp;guid=b277c29947dc7124bb50efd0bb362127&amp;type=3#Icon_Exit" name="ExitButton" style="position: relative; right: 10px; padding: 4px; max-height: 32px; min-height: 32px;" />
    </ui:VisualElement>
</ui:UXML>
