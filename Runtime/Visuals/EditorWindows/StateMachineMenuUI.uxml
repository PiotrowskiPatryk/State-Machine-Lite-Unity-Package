<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineEditor/StateMachineEditor-Styles.uss?fileID=7433441132597879392&amp;guid=163ddde40eaf8431c92dc64dc65b31e9&amp;type=3#StateMachineEditor-Styles" />
    <ui:VisualElement data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineEditor.Data.Definition.StateMachineDefinition, Dev.Cortez.StateMachines.Editor" class="background-main" style="flex-grow: 1;">
        <ui:VisualElement name="HeaderSection" style="flex-grow: 0; height: 50px; border-bottom-color: rgba(17, 115, 212, 0.14); border-bottom-width: 2px; align-items: center; justify-content: center;">
            <ui:Label text="State Machine Node Editor" class="text-bold" style="font-size: 24px; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="MenuSection" style="width: 250px; border-right-color: rgba(17, 115, 212, 0.14); border-right-width: 2px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; visibility: visible; display: flex; overflow: visible;">
                <ui:Label text="State Machine Setup" class="text-bold" style="font-size: 20px; -unity-text-align: middle-left; color: rgb(255, 255, 255);" />
                <ui:TextField label="State Machine Name" name="TextField-StateMachineName">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="_name" binding-mode="TwoWay" />
                    </Bindings>
                </ui:TextField>
                <ui:TextField label="Description" name="TextField-Description" multiline="true" style="min-height: 128px; max-height: 128px;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="_description" binding-mode="TwoWay" />
                    </Bindings>
                </ui:TextField>
                <ui:TextField label="Type" name="TextField-StateMachineType">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="_stateMachineTypeName" binding-mode="TwoWay" />
                    </Bindings>
                </ui:TextField>
                <ui:TextField label="Transition Solver" name="TextField-TransitionSolverType" data-source-path="_transitionSolverTypeName" />
                <ui:Label text="States" class="text-bold" style="font-size: 18px; -unity-text-align: middle-left;" />
                <ui:ListView show-add-remove-footer="true" />
            </ui:VisualElement>
            <ui:VisualElement name="GraphSection" style="flex-grow: 1;" />
            <ui:VisualElement name="InspectorSection" style="flex-grow: 0; width: 250px; border-left-color: rgba(17, 115, 212, 0.14); border-left-width: 2px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
