<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/dev.cortez.state-machines/Editor/StateMachineEditor/StateMachineEditor-Styles.uss?fileID=7433441132597879392&amp;guid=163ddde40eaf8431c92dc64dc65b31e9&amp;type=3#StateMachineEditor-Styles" />
    <ui:VisualElement data-source-type="Dev.Cortez.StateMachines.Editor.StateMachineEditor.ViewModels.StateDefinitionViewModel, Dev.Cortez.StateMachines.Editor" class="background-main" style="flex-grow: 1; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; align-items: stretch; justify-content: center; margin-top: 5px; margin-bottom: 5px; max-height: 35px; min-height: 35px;">
        <ui:Label text="{StateName}" selectable="true" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="text-normal" style="color: rgb(255, 255, 255); justify-content: center; align-self: auto; align-items: auto; align-content: auto; padding-left: 6px; font-size: 14px;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="StateName" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
