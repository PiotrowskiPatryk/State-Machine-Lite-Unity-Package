.button-no-border {
    background-color: rgba(0, 0, 0, 0);
    -unity-font: url("project://database/Assets/Test/Inter-VariableFont_opsz,wght.ttf?fileID=12800000&guid=cd98b80116b484ae09e16718ab2aea43&type=3#Inter-VariableFont_opsz,wght");
    color: rgb(255, 255, 255);
    font-size: 18px;
    opacity: 1;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.selected {
    color: rgb(17, 115, 212);
    border-bottom-width: 1px;
    border-bottom-color: rgb(17, 115, 212);
}

.not-selected {
    color: rgb(163, 163, 163);
}

.button-no-border:hover {
    border-bottom-color: rgb(17, 115, 212);
}

.table-label {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font: url("project://database/Assets/Test/Inter-VariableFont_opsz,wght.ttf?fileID=12800000&guid=cd98b80116b484ae09e16718ab2aea43&type=3#Inter-VariableFont_opsz,wght");
    -unity-text-align: middle-left;
}

.table-header {
    background-color: rgba(59, 130, 246, 0.5);
    max-height: 48px;
    height: 48px;
    border-left-color: rgba(59, 130, 246, 0.75);
    border-right-color: rgba(59, 130, 246, 0.75);
    border-top-color: rgba(59, 130, 246, 0.75);
    border-bottom-color: rgba(59, 130, 246, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding-right: 30px;
    padding-left: 30px;
    align-items: stretch;
    justify-content: flex-start;
    align-self: auto;
}
